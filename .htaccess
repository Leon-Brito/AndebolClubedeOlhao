Options -Indexes

RewriteEngine On
RewriteBase /

RewriteRule ^api/(.*)$ api.php?path=$1 [QSA,L]

RewriteRule ^login/?$ login.html [L]
RewriteRule ^admin-view\.html$ admin.php [L]
RewriteRule ^admin/?$ admin.php [L]
RewriteRule ^admin\.html$ admin.php [L]
RewriteRule ^logout/?$ api.php?path=logout [QSA,L]

<FilesMatch "^(\.env|config\.php|server\.js|app\.js|package\.json|package-lock\.json)$">
    Require all denied
</FilesMatch>